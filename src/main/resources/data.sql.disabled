-- =========================
-- 9) COMMENT (20) — application i, user ((i % 20)+1)
-- =========================
INSERT INTO comment (content, rating, application_id, user_id)
VALUES
    ('자기소개가 구체적이고 목표가 뚜렷해서 인상 깊었습니다. 앞으로의 성장 가능성이 커 보입니다.',4.5,1,2),
    ('전반적으로 성실함은 느껴지지만 지원 동기 부분이 조금 더 구체적이면 좋겠습니다.',3.8,2,3),
    ('활동 가능 요일을 명확하게 적어 준 점이 좋았습니다. 일정 관리가 잘 된 지원자라는 느낌입니다.',4.2,3,4),
    ('경험을 잘 정리해 두었고, 관련 활동들이 동아리와도 잘 맞아 보입니다.',4.0,4,5),
    ('장단점을 솔직하게 적어 준 점은 좋았지만, 단점을 보완하기 위한 구체적인 계획이 있으면 더 좋겠습니다.',3.7,5,6),
    ('목표가 구체적이고 장기적인 관점까지 담겨 있어 매우 인상적이었습니다.',4.6,6,7),
    ('협업 경험을 실제 사례 중심으로 잘 풀어 써서 신뢰가 갔습니다.',4.1,7,8),
    ('역할에 대해 현실적인 기대와 책임감을 함께 보여 준 점이 좋았습니다.',3.9,8,9),
    ('시간 관리 방식이 체계적이라 프로젝트 단위 활동에도 잘 적응할 것 같습니다.',4.7,9,10),
    ('리더십 경험을 과장하지 않고 구체적인 사례로 설명한 점이 인상 깊었습니다.',4.3,10,11),
    ('갈등 상황에서의 대처 방식이 성숙해 보여 팀 내 분위기에도 긍정적인 영향을 줄 것 같습니다.',4.8,11,12),
    ('독서와 논문 경험이 다양하지만, 동아리 활동과의 연결 부분이 조금 더 분명했으면 좋겠습니다.',3.6,12,13),
    ('포트폴리오 구성이 직관적이고, 실제로 실행해 본 프로젝트 비중이 커서 좋았습니다.',4.4,13,14),
    ('학습 계획이 전체적으로는 괜찮지만, 세부적인 일정이 조금 더 구체적이면 더 좋을 것 같습니다.',4.1,14,15),
    ('봉사 경험은 좋았지만 이 경험이 개발 활동과 어떻게 연결되는지에 대한 설명이 다소 아쉬웠습니다.',3.5,15,16),
    ('동호회 경험을 통해 배운 점을 잘 정리해 두어, 새로운 환경에서도 금방 적응할 것 같습니다.',4.9,16,17),
    ('프로젝트 경험이 실제 협업 과정 중심으로 작성되어 있어 신뢰가 갔습니다.',4.2,17,18),
    ('본인의 강점을 나열하기보다는 예시와 함께 설명해 주면 더 설득력이 있었을 것 같습니다.',3.8,18,19),
    ('약점을 솔직하게 적어 준 점은 좋았고, 개선을 위해 노력 중인 부분도 잘 보였습니다.',4.0,19,20),
    ('마지막에 하고 싶은 말을 통해 동아리에 대한 관심과 열정이 잘 전달되었습니다.',4.6,20,1),

    ('전체적으로 지원 의도가 명확하고, 동아리 활동을 통해 무엇을 얻고 싶은지 잘 드러난 자기소개였습니다.',4.2,21,1),
    ('지원 동기는 좋지만, 본인이 어떤 기여를 할 수 있을지 구체적인 부분이 조금 더 보였으면 합니다.',4.0,22,2),
    ('이전 활동 경험과 동아리에서의 목표가 잘 연결되어 있어 설득력이 있었습니다.',4.5,23,3),
    ('경험은 다양하지만 핵심을 조금 더 압축해서 작성하면 더 읽기 좋을 것 같습니다.',3.8,24,4),
    ('프론트엔드에 대한 관심과 학습 의지가 분명하게 드러나 좋았습니다.',4.7,25,5),
    ('기본기가 탄탄해 보이고, 차분하게 성장해 나갈 타입 같다는 인상을 받았습니다.',4.3,26,6),
    ('열정은 잘 느껴지지만, 구체적인 기술 스택이나 진행 중인 공부 내용이 조금 더 있었으면 합니다.',3.9,27,7),
    ('자기소개와 경험 정리가 깔끔하며, 협업에 대한 태도도 긍정적으로 느껴졌습니다.',4.8,28,8),
    ('관심 분야가 분명하고, 실제로 실행한 학습 내용도 잘 정리되어 있어 좋았습니다.',4.2,29,9),
    ('의지는 있지만 아직 방향성이 조금 흔들리는 느낌이라, 목표를 더 명확히 잡으면 좋겠습니다.',3.6,30,10),

    ('지원 동기와 장래 희망이 잘 맞아 떨어져서, 동아리 활동과의 궁합이 좋아 보였습니다.',4.5,31,11),
    ('활동 가능 시간과 우선순위를 솔직하게 적어 준 점이 인상적이었습니다.',4.0,32,12),
    ('프로젝트 경험과 배운 점을 잘 정리해, 성장 과정이 눈에 보이는 지원서였습니다.',4.9,33,13),
    ('기본적인 내용은 좋지만, 다른 지원자와 차별화되는 포인트가 조금 더 있으면 좋겠습니다.',4.1,34,14),
    ('협업 경험은 있지만 갈등 상황에 대한 구체적인 예시가 있었다면 더 좋았을 것 같습니다.',3.7,35,15),
    ('학습과 실전 경험의 균형이 좋았고, 앞으로의 계획도 현실적으로 잘 세워져 있습니다.',4.4,36,16),
    ('전반적으로 완성도가 높은 지원서였고, 특히 프로젝트 회고 부분이 인상 깊었습니다.',4.8,37,17),
    ('기본 역량은 충분해 보이지만, 아직은 본인만의 색깔이 완전히 드러나지 않은 느낌입니다.',4.0,38,18),
    ('꾸준히 공부해 온 흔적은 보이지만, 실제 서비스로 연결한 경험이 더 있으면 좋겠습니다.',3.9,39,19),
    ('기술과 협업 모두에 관심이 있어, 팀 단위 프로젝트에 잘 어울릴 것 같다는 인상을 받았습니다.',4.6,40,20),

    ('성실함과 책임감이 잘 드러나는 자기소개였고, 함께 프로젝트를 진행해 보고 싶은 느낌이었습니다.',4.2,41,1),
    ('지원 의도는 좋지만, 본인의 현재 실력 수준에 대한 설명이 조금 더 있으면 좋겠습니다.',3.8,42,2),
    ('이전 팀 활동 경험이 구체적으로 잘 설명되어 있어 신뢰가 갔습니다.',4.5,43,3),
    ('동아리에서 하고 싶은 활동이 명확하고, 실제로 실행 가능한 계획으로 보였습니다.',4.7,44,4),
    ('전체적으로 균형 잡힌 지원서였으며, 팀워크에 대한 태도도 긍정적으로 느껴졌습니다.',4.3,45,5),
    ('기본기보다 열정이 먼저 느껴지는 타입이라, 실제 활동 속에서 더 성장할 것 같습니다.',4.1,46,6),
    ('내용이 진솔하고 꾸밈이 적어 호감이 갔지만, 기술적인 부분 설명은 조금 부족해 보입니다.',3.9,47,7),
    ('데이터나 분석 관련 경험이 실제로 잘 정리되어 있어, 관련 프로젝트에 함께하면 좋겠다는 생각이 들었습니다.',4.6,48,8),
    ('웹 백엔드에 대한 관심이 분명하고, 이미 어느 정도 방향을 잡고 있는 점이 인상적이었습니다.',4.0,49,9),
    ('협업과 커뮤니케이션 능력을 강조한 점은 좋지만, 구체적인 사례가 조금 더 있었으면 합니다.',3.7,50,10),

    ('테스트 코드에 대한 관심과 경험이 비교적 잘 드러나 있어, 안정적인 개발을 지향하는 스타일로 보였습니다.',4.8,51,11),
    ('디자인과 개발을 함께하려는 시도가 인상적이었고, 협업 시 강점이 될 것 같습니다.',4.2,52,12),
    ('REST API 설계에 대한 관심이 분명하고, 학습 방향도 크게 벗어나지 않아 좋아 보입니다.',4.4,53,13),
    ('DB 튜닝에 대한 관심은 좋지만, 실제로 시도해 본 경험이 더 상세히 적혀 있으면 더 믿음이 갔을 것 같습니다.',3.6,54,14),
    ('형상 관리와 협업 경험이 잘 녹아 있어, 팀 개발 환경에서 큰 도움이 될 것 같은 지원자입니다.',4.7,55,15),
    ('테스트 자동화에 대한 시도와 관심이 잘 드러나 있어, 장기적으로 큰 강점이 될 것 같습니다.',4.1,56,16),
    ('열정은 충분히 느껴지지만, 아직 경험의 폭이 좁아서 활동을 통해 더 채워 나가야 할 것 같습니다.',3.8,57,17),
    ('배포 자동화와 인프라에 관심이 뚜렷하고, 관련 학습 계획도 잘 정리되어 있었습니다.',4.9,58,18),
    ('도커와 CI 경험을 실제 사례와 함께 설명해 준 점이 좋았고, 실전에 바로 투입 가능한 역량으로 보입니다.',4.3,59,19),
    ('코드 리뷰 경험이 있기는 하지만, 어떤 기준으로 리뷰를 했는지에 대한 설명이 조금 더 있으면 좋겠습니다.',3.9,60,20),

    ('JPA와 객체지향에 대해 고민하는 흔적이 보여, 함께 설계 고민을 해보고 싶은 지원자였습니다.',4.5,61,1),
    ('성능 최적화에 대한 흥미는 잘 드러났지만, 아직은 실전 적용 사례가 부족한 편으로 보입니다.',4.0,62,2),
    ('이벤트 기반 설계에 관심을 갖고 있는 점이 신선했고, 관련 프로젝트 의지도 잘 보였습니다.',4.6,63,3),
    ('모니터링과 로깅에 대한 관점이 좋지만, 사용하는 도구나 구체적인 경험이 조금 더 있었으면 합니다.',3.7,64,4),
    ('개발에 대한 열정과 성장 의지가 분명해 보이며, 동아리와 함께 빠르게 성장할 수 있을 것 같습니다.',4.8,65,5),
    ('복수전공을 준비하며 다양한 시각을 갖고 있는 점이 강점으로 느껴졌습니다.',4.2,66,6),
    ('데이터 엔지니어링과 백엔드 모두에 관심이 있어, 장기적으로 큰 역할을 할 수 있을 지원자로 보입니다.',4.9,67,7);

