-- =========================
-- 5) CLUB_APPLY_FORM
-- =========================
INSERT INTO club_apply_form (club_id, title, description)
VALUES
    (1, '인터엑스 2025 상반기 모집', '사회문제 해결과 토론에 열정이 있는 분들을 모집합니다. 함께 배우고 실천하며 변화를 만들어가요.'),
    (2, '에이아이디브 2025 상반기 신입 부원 모집', 'AI와 데이터 분석에 관심 있는 학생들을 환영합니다. 논문 스터디와 프로젝트를 함께해요.'),
    (3, '코드마스터 2025 상반기 리쿠르팅', '프로그래밍 실력을 키우고 싶은 개발자 지망생을 모집합니다. 함께 배우고 성장합시다.'),
    (4, '로보테크 2025 신입 회원 모집', '로봇공학, 드론, 제어 시스템에 관심 있는 학생을 모집합니다. 하드웨어 제작부터 코딩까지 함께합니다.'),
    (5, '아트픽 2025 전시 참여 회원 모집', '창작 활동과 전시에 참여할 예술적 감각을 가진 분을 찾습니다. 미술·디자인 전공자 우대.'),
    (6, '리버스 2025 공연팀 신입 모집', '보컬, 연주, 작곡 등 음악에 열정 있는 부원을 모집합니다. 정기 공연을 함께 만들어가요.'),
    (7, '포커스 2025 상반기 신입 회원 모집', '사진과 영상 제작에 관심 있는 분을 찾습니다. 장비가 없어도 열정만 있으면 환영합니다.'),
    (8, '온기나눔 2025 봉사활동 참가자 모집', '지역 아동센터 및 복지시설 봉사활동에 함께할 따뜻한 마음의 부원을 찾습니다.'),
    (9, '비즈온 2025 창업 아이디어팀 모집', '창업과 비즈니스에 관심 있는 학생들을 위한 리쿠르팅입니다. 함께 스타트업을 만들어봐요.'),
    (10, '핀라이트 2025 경제·금융 세미나 참여자 모집', '금융과 투자에 관심 있는 학생을 모집합니다. 주식 모의투자와 시사 세미나를 함께합니다.'),
    (11, '글로비아 2025 상반기 글로벌 토론 동아리 모집', '영어 회화와 국제 교류에 관심 있는 학생을 모집합니다. 외국인 교환학생과의 토론 세션을 운영합니다.'),
    (12, '사이언스큐브 2025 연구 프로젝트 팀원 모집', '과학 실험과 탐구에 열정 있는 학생을 모집합니다. 팀별 실험을 설계하고 논문 형식으로 정리합니다.'),
    (13, '글빛 2025 문예창작 신입 회원 모집', '문학, 시, 소설, 수필에 관심 있는 학생을 환영합니다. 창작과 토론을 통해 감성을 나눕니다.'),
    (14, '무대열전 2025 공연팀 오디션 안내', '연극과 공연예술에 관심 있는 학생을 모집합니다. 배우·연출·조명 등 다양한 역할이 있습니다.'),
    (15, '겜팩토리 2025 상반기 개발팀 모집', '게임 기획·디자인·프로그래밍 등 팀 단위 창작에 함께할 인원을 찾습니다. Unity 경험자 환영.'),
    (16, '프레임 2025 상반기 사진기자단 모집', '사진저널리즘에 관심 있는 학생을 모집합니다. 사회 이슈를 기록하는 프로젝트를 진행합니다.'),
    (17, '로드메이커 2025 문화탐방 참가자 모집', '여행과 답사를 통해 다양한 문화를 배우고 싶은 학생을 찾습니다. 학기 중 소규모 탐방 진행.'),
    (18, 'FC JNU 2025 신입 선수 모집', '축구를 좋아하는 누구나 환영합니다! 교내 리그 및 정기 연습 경기에 참여할 팀원을 모집합니다.'),
    (19, '그린리프 2025 친환경 프로젝트 부원 모집', '환경 보호와 지속 가능한 활동에 관심 있는 학생을 모집합니다. 캠페인 기획 및 플로깅 활동 진행.'),
    (20, '에어로랩 2025 드론 연구팀 신입 모집', '드론과 항공기술을 연구할 열정적인 부원을 찾습니다. 직접 제작 및 비행 테스트에 참여합니다.');

