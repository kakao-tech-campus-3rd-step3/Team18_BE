INSERT INTO answer (application_id, form_question_id, answer)
VALUES
    (1, 1, '안녕하세요. 컴퓨터공학과 3학년 홍길동입니다. 백엔드 개발과 서버 운영에 관심이 많습니다.'),
    (1, 2, '예, 개인 프로젝트로 간단한 게시판 서비스를 만들어 본 경험이 있습니다.'),
    (1, 3, '현재 자바와 Spring을 중심으로 웹 백엔드 개발을 공부하고 있으며, 동아리 활동을 통해 실제 서비스 개발을 경험해 보고 싶습니다.'),
    (1, 4, '2025-10-15 10:00~12:00 사이 면접 참여가 가능하며, 필요하다면 약간의 시간 조정도 가능합니다.'),

    (2, 2, '예, 정기 모임과 세미나에 꾸준히 참여할 수 있는 일정입니다.'),
    (3, 3, '월요일과 수요일 저녁, 토요일 오후에 정기 활동 참여가 가능합니다.'),
    (4, 4, '학과 팀 프로젝트에서 백엔드 개발을 맡아 API 설계와 데이터베이스 연동을 경험해 본 적이 있습니다.'),
    (5, 5, '책임감이 강해 맡은 일은 끝까지 해내는 편이지만, 완벽하게 해내고 싶어 결정이 느려질 때가 있는 편입니다.'),
    (6, 6, '1년 안에 스스로 설계한 웹 서비스를 하나 이상 배포해 보고, 이후에는 인턴이나 공모전을 통해 실무 경험을 쌓는 것이 목표입니다.'),
    (7, 7, '5인 팀으로 진행한 웹 서비스 프로젝트에서 역할을 분담하고 코드 리뷰를 통해 협업한 경험이 있습니다.'),
    (8, 8, '백엔드 개발자로 참여해 API 설계, 비즈니스 로직 구현, 데이터베이스 모델링을 중심으로 기여하고 싶습니다.'),
    (9, 9, '주간 단위로 해야 할 일을 정리하고, 캘린더와 할 일 목록을 사용해 마감일을 관리하며 우선순위에 따라 시간을 배분합니다.'),
    (10, 10, '알고리즘 스터디에서 스터디장을 맡아 매주 문제를 선정하고 진행을 조율하며 팀원들을 이끌었던 경험이 있습니다.'),
    (11, 11, '팀 프로젝트에서 일정 지연으로 갈등이 발생했을 때, 회의를 열어 서로의 상황을 공유하고 업무 분담을 다시 조정해 문제를 해결한 경험이 있습니다.'),
    (12, 12, '클린 코드와 도메인 주도 설계 관련 서적을 읽으며 코드 품질과 설계 방식에 대해 많이 고민해 보았습니다.'),
    (13, 13, '개인 블로그 서비스와 일정 관리 웹 서비스를 구현한 포트폴리오가 있으며, 코드와 설명을 GitHub에 정리해 두었습니다.'),
    (14, 14, '학기 중에는 자바와 Spring 심화 학습에 집중하고, 방학에는 배포 자동화와 모니터링까지 포함한 전체 플로우를 경험해 볼 계획입니다.'),
    (15, 15, '지역 아동센터에서 중·고등학생을 대상으로 기초 코딩과 IT 진로를 소개하는 봉사 활동에 참여한 경험이 있습니다.'),
    (16, 16, '대학 1학년 때 IT 학회에 참여해 세미나를 준비하고, 교내 해커톤에 참가해 팀 프로젝트를 수행한 경험이 있습니다.'),
    (17, 17, '교내 공모전에 출품한 스터디 매칭 플랫폼 프로젝트에서 백엔드 개발과 간단한 인프라 구성을 담당했습니다.'),
    (18, 18, '새로운 기술을 빠르게 익히는 편이며, 문서화와 정리를 좋아해 팀원들이 이해하기 쉽도록 정리된 자료를 만드는 것이 강점입니다.'),
    (19, 19, '여러 일을 한 번에 맡으려는 경향이 있어 가끔 과로하게 되지만, 최근에는 우선순위를 나누어 일정과 업무량을 조절하려고 노력하고 있습니다.'),
    (20, 20, '동아리 활동을 통해 함께 성장하면서 실제로 사용할 수 있는 서비스를 만들어 보고 싶습니다. 적극적으로 참여하겠습니다.'),

    (21, 1, '안녕하세요. 소프트웨어학부 2학년 김지원입니다. 백엔드와 협업 문화에 관심이 많습니다.'),
    (21, 2, '예, 정기 세션과 프로젝트에 꾸준히 참여할 수 있습니다.'),
    (21, 3, '팀 프로젝트를 좋아하고, 사람들과 의견을 나누며 서비스 방향을 정하는 과정을 즐깁니다.'),
    (21, 4, '2025-10-16 14:00~16:00 면접 참여가 가능하며, 그 외 저녁 시간대도 조정 가능합니다.'),

    (22, 1, '안녕하세요. 통계학과 3학년 이서준입니다. 데이터 분석과 서버 개발을 함께 경험해 보고 싶습니다.'),
    (22, 2, '아니오, 교환학생 준비로 인해 이번 학기에는 전 기간 활동이 어려워 한 학기 정도만 참여가 가능합니다.'),
    (22, 3, '데이터 분석과 시각화에 관심이 많고, 분석 결과를 실제 서비스 기능으로 연결해 보고 싶습니다.'),
    (22, 4, '2025-10-15 10:00~12:00 사이 면접이 가장 좋으며, 오전 시간대 조정은 가능합니다.'),

    (23, 1, '안녕하세요. 컴퓨터공학과 2학년 박민지입니다. 동아리 활동을 통해 실전 경험을 쌓고 싶습니다.'),
    (23, 2, '예, 학기 중 일정 조율이 가능해 정기 모임에 성실히 참여할 수 있습니다.'),
    (23, 3, '이미 다른 동아리에서 기획과 운영을 경험해 보았고, 이번에는 개발에 집중해 보고 싶습니다.'),
    (23, 4, '2025-10-16 14:00~16:00 면접 참여 가능하며, 이후 저녁 시간도 일부 가능합니다.'),

    (24, 1, '안녕하세요. 정보통신공학과 4학년 정영훈입니다. 졸업 전 마지막으로 의미 있는 프로젝트를 해 보고 싶습니다.'),
    (24, 2, '예, 졸업 학기이지만 시간 조율이 가능해 정기 활동에 참여할 수 있습니다.'),
    (24, 3, '과 대표와 프로젝트 팀장을 맡아본 경험이 있어 리더십과 책임감을 발휘하는 데 자신이 있습니다.'),
    (24, 4, '2025-10-15 10:00~12:00 면접을 선호하지만, 오후에도 일정 조정이 가능합니다.'),

    (25, 1, '안녕하세요. 미디어학부 2학년 한서윤입니다. 프론트엔드와 디자인 협업에 관심이 많습니다.'),
    (25, 2, '예, 수업과 병행 가능하여 주당 정해진 시간 이상 활동할 수 있습니다.'),
    (25, 3, '프론트엔드와 UI에 관심이 있어 사용자 입장에서 보기 편한 화면을 만드는 것을 좋아합니다.'),
    (25, 4, '2025-10-16 14:00~16:00 면접 참여 가능하며, 저녁 시간도 일부 가능합니다.'),

    (26, 1, '안녕하세요. 컴퓨터공학과 1학년 지원자입니다. 학교 생활과 함께 개발 경험을 쌓고 싶습니다.'),
    (26, 2, '예, 수업 이후 저녁 시간에 정기 모임에 꾸준히 참여할 수 있습니다.'),
    (26, 3, '기초 문법을 배우는 단계이지만, 프로젝트를 통해 빠르게 성장하고 싶어 동아리에 지원했습니다.'),

    (27, 1, '안녕하세요. 소프트웨어학부 2학년 지원자입니다. 웹 개발 전반을 배우고 싶습니다.'),
    (27, 2, '예, 시험 기간을 제외하고 대부분의 정기 활동에 참석할 수 있습니다.'),
    (27, 3, '혼자 공부하는 것보다 함께 공부하며 피드백을 주고받는 것을 좋아해 동아리를 찾게 되었습니다.'),

    (28, 1, '안녕하세요. 정보보호학과 3학년 지원자입니다. 보안과 서버 개발에 모두 관심이 있습니다.'),
    (28, 2, '예, 주중 저녁과 주말 일부 시간을 동아리 활동에 투자할 수 있습니다.'),
    (28, 3, '기초적인 웹 보안 지식을 갖추고 있으며, 안전한 백엔드 구조를 고민해 보고 싶습니다.'),

    (29, 1, '안녕하세요. 전자공학과 2학년 지원자입니다. 하드웨어와 소프트웨어를 함께 이해하고 싶습니다.'),
    (29, 2, '예, 실험 과목과 병행하면서도 정기 모임에 참여할 수 있는 일정입니다.'),
    (29, 3, '임베디드와 서버를 연결하는 프로젝트에 관심이 있어 관련 경험을 쌓고자 지원했습니다.'),

    (30, 1, '안녕하세요. 컴퓨터공학과 4학년 지원자입니다. 졸업 전 팀 프로젝트 경험을 더 쌓고 싶습니다.'),
    (30, 2, '예, 졸업 준비와 병행하면서도 주 2회 이상 활동이 가능합니다.'),
    (30, 3, '이미 몇 차례 팀 프로젝트를 진행해 봤으며, 이번에는 서비스 완성도에 더 집중해보고 싶습니다.'),

    (31, 1, '안녕하세요. 인공지능학과 1학년 지원자입니다. AI와 백엔드의 연계를 배우고 싶습니다.'),
    (31, 2, '예, 학기 대부분의 기간 동안 정기 활동이 가능합니다.'),
    (31, 3, '파이썬과 기초 머신러닝을 공부 중이고, 이를 실제 서비스에 적용해 보고 싶습니다.'),

    (32, 1, '안녕하세요. 수학과 3학년 지원자입니다. 알고리즘과 논리적인 문제 해결을 좋아합니다.'),
    (32, 2, '예, 학기 중 평일 저녁에 꾸준히 참여할 수 있습니다.'),
    (32, 3, '수학적 사고를 바탕으로 안정적인 서버 로직을 설계해 보고 싶습니다.'),

    (33, 1, '안녕하세요. 경영학과 2학년 지원자입니다. 서비스 기획과 개발 협업에 관심이 있습니다.'),
    (33, 2, '예, 수업 외 시간에 프로젝트와 스터디에 적극적으로 참여할 수 있습니다.'),
    (33, 3, '기획 관점에서 아이디어를 제안하고, 개발 과정도 함께 이해하고 싶어 지원했습니다.'),

    (34, 1, '안녕하세요. 산업공학과 3학년 지원자입니다. 데이터 기반 서비스에 관심이 많습니다.'),
    (34, 2, '예, 평일 저녁과 주말 일부 시간을 투자할 수 있습니다.'),
    (34, 3, '프로세스 개선과 데이터 분석 경험을 바탕으로 서비스 품질을 높이는 데 기여하고 싶습니다.'),

    (35, 1, '안녕하세요. 컴퓨터공학과 복수전공 중인 인문대학 3학년 지원자입니다.'),
    (35, 2, '예, 일정 조율을 통해 정기 모임에 참여할 수 있습니다.'),
    (35, 3, '문과와 이과의 관점을 모두 가진 구성원으로서 소통과 문서화에 강점이 있습니다.'),

    (36, 1, '안녕하세요. 소프트웨어학부 1학년 지원자입니다. 개발을 처음부터 제대로 배우고 싶습니다.'),
    (36, 2, '예, 주중 저녁 시간에 꾸준히 활동할 수 있습니다.'),
